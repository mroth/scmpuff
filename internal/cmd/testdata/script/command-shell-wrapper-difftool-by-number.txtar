# Scenario: Wrapped git difftool works with numeric arg
# Purpose: Verify difftool receives the expanded path rather than a literal "1",
# which git would otherwise reject as an ambiguous argument.
# Verbose notes: Uses --extcmd=echo so no real diff tool is required; the echoed
# second argument is $REMOTE, which must be the relative worktree path.
# zsh runs with -f: zsh reads /etc/zshenv for every shell, and on some systems
# (e.g. nix-darwin) that prepends profile dirs to PATH, shadowing the scmpuff
# binary under test with an installed one.

exec git init repo_base
cd repo_base
exec git add foo.bar
exec git commit -m 'initial commit'
cp ../foo.bar.modified foo.bar
cd ..

# Bash
[exec:bash] exec cp -R repo_base repo_bash
[exec:bash] cd repo_bash
[exec:bash] exec bash -c 'eval "$(scmpuff init -s)"; scmpuff_status >/dev/null; git difftool -y --extcmd=echo 1'
[exec:bash] stdout ' foo\.bar'
[exec:bash] cd ..

# Zsh
[exec:zsh] exec cp -R repo_base repo_zsh
[exec:zsh] cd repo_zsh
[exec:zsh] exec zsh -f -c 'eval "$(scmpuff init -s)"; scmpuff_status >/dev/null; git difftool -y --extcmd=echo 1'
[exec:zsh] stdout ' foo\.bar'
[exec:zsh] cd ..

# Fish
[exec:fish] exec cp -R repo_base repo_fish
[exec:fish] cd repo_fish
[exec:fish] exec fish -c 'scmpuff init --shell=fish | source; scmpuff_status >/dev/null; git difftool -y --extcmd=echo 1'
[exec:fish] stdout ' foo\.bar'
[exec:fish] cd ..

-- repo_base/foo.bar --
ab

-- foo.bar.modified --
abcd
